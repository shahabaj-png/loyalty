# Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Database
DATABASE_URL=postgresql://loyalty_user:YOUR_SECURE_PASSWORD@localhost:5432/loyalty_platform

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (IMPORTANT: Generate strong random strings for production)
# You can generate these using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_64_CHARS_MIN
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=4000
NODE_ENV=production

# App URLs (Replace with your actual domain)
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Identity Verification (Optional - Onfido)
# ONFIDO_API_TOKEN=your-onfido-api-token
# ONFIDO_WEBHOOK_SECRET=your-onfido-webhook-secret

# Facial Recognition (Optional - AWS Rekognition)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REKOGNITION_COLLECTION=loyalty-faces

# Notifications (Optional)
# SENDGRID_API_KEY=your-sendgrid-key
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# S3 Storage (Optional)
# AWS_S3_BUCKET=loyalty-platform-uploads
# AWS_S3_REGION=us-east-1

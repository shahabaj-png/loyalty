{
  "expo": {
    "name": "Loyalty Rewards",
    "slug": "loyalty-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#6366F1" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.loyaltyplatform.app", "infoPlist": { "NSCameraUsageDescription": "Camera is used for ID verification and facial recognition", "NSFaceIDUsageDescription": "Face ID is used for secure login" } },
    "android": { "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#6366F1" }, "package": "com.loyaltyplatform.app", "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"] },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-camera", "expo-local-authentication", "expo-notifications"]
  }
}
